if (@KARMA_ENABLE_NAVIGATION@)
  find_package(RecastNavigation QUIET CONFIG)
  if (NOT TARGET Recast OR NOT TARGET Detour)
    find_package(recastnavigation QUIET CONFIG)
  endif()
  foreach (karma_recast_target IN ITEMS Recast Detour DetourCrowd DetourTileCache DebugUtils)
    if (TARGET RecastNavigation::${karma_recast_target} AND NOT TARGET ${karma_recast_target})
      add_library(${karma_recast_target} INTERFACE IMPORTED)
      set_target_properties(${karma_recast_target} PROPERTIES
        INTERFACE_LINK_LIBRARIES RecastNavigation::${karma_recast_target})
    endif()
  endforeach()
  if ((NOT TARGET Recast OR NOT TARGET Detour) AND KARMA_CONFIG_FETCH_DEPS)
    set(RECASTNAVIGATION_DEMO OFF CACHE BOOL "" FORCE)
    set(RECASTNAVIGATION_EXAMPLES OFF CACHE BOOL "" FORCE)
    set(RECASTNAVIGATION_TESTS OFF CACHE BOOL "" FORCE)
    set(RECASTNAVIGATION_DT_VIRTUAL_QUERYFILTER ON CACHE BOOL "" FORCE)
    FetchContent_Declare(
      recastnavigation
      GIT_REPOSITORY https://github.com/recastnavigation/recastnavigation.git
      GIT_TAG v1.6.0
    )
    FetchContent_MakeAvailable(recastnavigation)
  endif()
  _karma_require_target(Recast RecastNavigation)
  _karma_require_target(Detour RecastNavigation)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/karmaTargets.cmake")
if (TARGET karma::karma_features_ui_native AND _karma_ui_freetype_link_only)
  foreach (_karma_freetype_link IN LISTS _karma_ui_freetype_link_only)
    set_property(TARGET karma::karma_features_ui_native APPEND PROPERTY
      INTERFACE_LINK_LIBRARIES "$<LINK_ONLY:${_karma_freetype_link}>")
  endforeach()
endif()
unset(_karma_freetype_link)
unset(_karma_ui_freetype_link_only)
set(CMAKE_MODULE_PATH "${_karma_saved_cmake_module_path}")
check_required_components(karma)
