# Energy orb prefab.

[prefab]
name = Energy Orb

[param accent]
type = color
default = 0.18, 1.0, 0.28, 1.0

[mesh shell]
mesh = ../../shot.glb
position = 0.0, 0.0, 0.0
uniform_scale = 1.3125
visible = true
shadow_visible = false
material.base_color_param = accent
material.base_color_scale = 0.86, 0.86, 0.86, 0.90
material.base_color_mix = 1.0, 1.0, 1.0, 1.0
material.base_color_mix_factor = 0.16
material.emissive_color_param = accent
material.emissive_color_scale = 0.18, 0.24, 0.18, 1.0
material.metallic = 0.0
material.roughness = 0.015
material.occlusion_strength = 0.0
material.shading_model = energy_shell
material.shell_fresnel_power = 5.4
material.shell_fresnel_strength = 0.10
material.shell_refraction_strength = 0.0
material.shell_interior_strength = 0.92
material.shell_highlight_strength = 0.0
material.shell_alpha_boost = 0.24
material.shell_swirl_strength = 0.82
material.analytic_sphere_normals = true
material.unlit = true
material.transparent = true
material.depth_write = false
material.double_sided = true

[particle core]
effect = energy_orb_core
position = 0.0, 0.0, 0.0
override.size_scale = 0.1875
override.radius_scale = 0.1875
override.velocity_scale = 0.1875
override.start_color = 1.0, 1.0, 1.0, 0.98
override.end_color_param = accent
override.end_color_scale = 0.85, 0.92, 0.85, 0.0

[particle arcs]
effect = energy_orb_arcs
position = 0.0, 0.0, 0.0
override.size_scale = 0.1875
override.radius_scale = 0.1875
override.velocity_scale = 0.1875
override.start_color = 1.0, 1.0, 1.0, 1.0
override.end_color_param = accent
override.end_color_scale = 0.92, 0.98, 0.92, 0.0

[particle halo]
effect = energy_orb_halo
position = 0.0, 0.0, 0.0
override.size_scale = 0.1875
override.radius_scale = 0.1875
override.velocity_scale = 0.1875
override.start_color_param = accent
override.start_color_scale = 0.28, 0.48, 0.28, 0.08
override.end_color_param = accent
override.end_color_scale = 0.12, 0.22, 0.12, 0.0

[particle distortion]
effect = energy_orb_distortion
position = 0.0, 0.0, 0.0
override.size_scale = 0.09375
override.radius_scale = 0.1875
override.velocity_scale = 0.1875
override.start_color = 1.0, 1.0, 1.0, 0.92
override.end_color = 1.0, 1.0, 1.0, 0.0

[light glow]
type = point
position = 0.0, 0.0, 0.0
color_param = accent
color_mix = 1.0, 1.0, 1.0, 1.0
color_mix_factor = 0.34
intensity = 9.75
range = 3.0
casts_shadows = false
