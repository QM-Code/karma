# Analytic wave sphere prefab.

[prefab]
name = Wave

[param color]
type = color
default = 0.18, 0.82, 1.0, 1.0

[param radius]
type = float
default = 2.2

[param opacity]
type = float
default = 0.3

[param distortion]
type = float
default = 1.8

[param noise]
type = float
default = 1.0

[param light_intensity]
type = float
default = 90.0

[param light_range]
type = float
default = 14.0

[volume_sphere body]
position = 0.0, 0.0, 0.0
color_param = color
emissive_color_param = color
emissive_color_scale = 2.4, 2.4, 2.4, 1.0
radius_param = radius
center_opacity_param = opacity
distortion_strength_param = distortion
noise_strength_param = noise
overlay_depth = 0.12
scale_with_transform = false
visible = true

[light glow]
type = point
position = 0.0, 0.0, 0.0
color_param = color
color_mix = 1.0, 1.0, 1.0, 1.0
color_mix_factor = 0.18
intensity_param = light_intensity
range_param = light_range
casts_shadows = false
