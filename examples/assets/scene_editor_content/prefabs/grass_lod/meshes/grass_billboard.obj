# Procedural single-card grass billboard from examples/rendering/grass_field.cpp.
mtllib grass_billboard.mtl
o Grass_Billboard
v -0.475000 0.000000 0.000000
v 0.475000 0.000000 0.000000
v 0.475000 1.250000 0.000000
v -0.475000 1.250000 0.000000
vt 0.000000 1.000000
vt 1.000000 1.000000
vt 1.000000 0.000000
vt 0.000000 0.000000
vn 0.000000 0.000000 1.000000
usemtl Grass_Billboard
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
