{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karma-engine.dev/schemas/ui/kstyle.v2.schema.json",
  "title": "Karma UI v2 theme",
  "description": "Machine-readable contract for .kstyle.json5 authoring themes after JSON5 canonicalization.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "karma.ui.theme" },
    "version": { "const": 2 },
    "imports": {
      "type": "array",
      "items": { "$ref": "common.v2.schema.json#/$defs/assetReference" }
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.v2.schema.json#/$defs/styleValue"
      }
    },
    "fonts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "src": { "$ref": "common.v2.schema.json#/$defs/assetReference" },
          "weight": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "style": { "enum": ["normal", "italic", "oblique"] },
          "face_index": { "type": "integer", "minimum": 0 }
        },
        "required": ["src"],
        "additionalProperties": false
      }
    },
    "motions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "duration_ms": { "type": "number", "minimum": 0 },
          "delay_ms": { "type": "number" },
          "easing": { "type": "string" },
          "iterations": {
            "oneOf": [
              { "type": "number", "minimum": 0 },
              { "const": "infinite" }
            ]
          },
          "direction": {
            "enum": ["normal", "reverse", "alternate", "alternate-reverse"]
          },
          "keyframes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": { "type": "number", "minimum": 0, "maximum": 1 },
                "appearance": {
                  "$ref": "common.v2.schema.json#/$defs/appearance"
                }
              },
              "required": ["at", "appearance"],
              "additionalProperties": false
            }
          }
        },
        "required": ["keyframes"],
        "additionalProperties": false
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": {
        "allOf": [
          { "$ref": "common.v2.schema.json#/$defs/styleEntry" },
          {
            "not": {
              "type": "object",
              "properties": { "extends": true },
              "required": ["extends"]
            }
          }
        ]
      }
    },
    "styles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.v2.schema.json#/$defs/styleEntry"
      }
    }
  },
  "required": ["format", "version"],
  "additionalProperties": false
}
